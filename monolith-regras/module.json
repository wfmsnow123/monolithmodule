{
  "id": "monolith-regras",
  "title": "Monolith: Regras da Casa",
  "description": "Regras de Monolith para dnd5e: Exaustão de 10 níveis, Inspiração e Inspiração Heróica, Ênfase. Recursos incorporados e adaptados (cada um liga e desliga): Lembretes de vantagem, Percepção, Visão, Montaria, Barra de Chefe, Ordenar inventário, Troca e Retratos. Substitui Advantage Reminder, Perceptive, Vision 5e, Rideable, Bossbar, Illandril's Inventory Sorter, Let's Trade 5e e Tokenizer.",
  "version": "0.8.2",
  "authors": [
    {
      "name": "snowxd"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13.351"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.2.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "tidy5e-sheet",
        "type": "module",
        "reason": "Exaustão de 10 níveis na ficha Tidy Clássica."
      },
      {
        "id": "monolith-resting",
        "type": "module",
        "reason": "Os descansos de Monolith (Fôlego, Vigília, Completo) e a limpeza do Fio ao descansar."
      },
      {
        "id": "monolith-medidas",
        "type": "module",
        "reason": "O Fio, as Medidas Desesperadas e a Queima de Alma. O retrato do painel abre as Medidas."
      },
      {
        "id": "monolith-perdicao",
        "type": "module",
        "reason": "A trilha de Perdição, Marcas e testes de Lucidez."
      },
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "A Percepção usa o libWrapper para conviver com outros módulos (funciona sem ele)."
      },
      {
        "id": "routinglib",
        "type": "module",
        "reason": "A Montaria usa o routinglib para o seguir com desvio de obstáculos."
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/monolith-ui.css",
    "styles/monolith.css",
    "recursos/lembretes/estilo.css",
    "recursos/percepcao/estilo.css",
    "recursos/visao/estilo.css",
    "recursos/montaria/estilo.css",
    "recursos/chefe/estilo.css",
    "recursos/inventario/estilo.css",
    "recursos/troca/estilo.css",
    "recursos/retratos/estilo.css"
  ],
  "socket": true,
